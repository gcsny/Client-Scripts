function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return;
    }
    // Handle empty field state immediately and exit
    if (newValue === '') {
        g_form.clearValue('manufacturer');
        g_form.clearValue('serial_number_device');
        g_form.clearValue('device_type');
        g_form.clearValue('capacity');
        g_form.clearValue('location_security_media');
        return; 
    }
    var ga = new GlideAjax('MassStorageDeviceUtils');
    ga.addParam('sysparm_name', 'getDeviceInformation');
    ga.addParam('sysparm_deviceasset', newValue);
    
    ga.getXMLAnswer(function(response) {
        if (response) {
            try {
                var deviceData = JSON.parse(response);
                // Set client fields from the database result
                g_form.setValue('manufacturer', deviceData.manufacturer);
                g_form.setValue('serial_number_device', deviceData.serialNumber);
                g_form.setValue('device_type', deviceData.deviceType);
                g_form.setValue('capacity', deviceData.capacity);
                g_form.setValue('location_security_media', deviceData.location, deviceData.locationDisplay);
            } catch (e) {
                jslog('Error parsing device data JSON: ' + e);
            }
        }
    });
}
