function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return;
    }
    if (newValue === '') {
        g_form.clearValue('replacement_device');
        g_form.clearValue('location_security_media');
        return;
    }
    var ga = new GlideAjax('MassStorageDeviceUtils');
    ga.addParam('sysparm_name', 'getDeviceInformation');
    ga.addParam('sysparm_deviceasset', newValue);

    ga.getXMLAnswer(function(response) {
        if (response) {
            try {
                var deviceData = JSON.parse(response);
                // Build replacement device string with device type and capacity comma separated
                var replacementValue = deviceData.deviceType + ', ' + deviceData.capacity;
                g_form.setValue('replacement_device', replacementValue);
                g_form.setValue('location_security_media', deviceData.location, deviceData.locationDisplay);
            } catch (e) {
                jslog('Error parsing device data JSON: ' + e);
            }
        }
    });
}
