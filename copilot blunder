            set: "application_server_details_virtual_server_provisioning"
        },

        //Unisys-Linux Projects - Linux App Server Names
        {
            group: "ee52a2c9b1611110964668d72675c6eb",
            keyword: "Provide Server Names for Linux Application Server(s)",
            set: "application_server_details_virtual_server_provisioning"
        },

        //Unisys-Windows Projects - Windows DB Server Names
        {
            group: "e63d5e85b1611110964668d72675c6f8",
            keyword: "Provide Server Names for Windows Database Server(s)",
            set: "db_server_details_virtual_server_provisioning"
        },

        //Unisys-Linux Projects - Linux DB Server Names
        {
            group: "ee52a2c9b1611110964668d72675c6eb",
            keyword: "Provide Server Names for Linux Database Server(s)",
            set: "db_server_details_virtual_server_provisioning"
        }
    ];

    // Apply rules
    config.forEach(function(item) {

        var assignmentGroup = g_form.getValue('assignment_group');
        var shortDesc = g_form.getValue('short_description').toString();
        var state = g_form.getValue('state');

        if (assignmentGroup === item.group &&
            shortDesc.includes(item.keyword) &&
            (state == 1 || state == 2)) {  // Open or Work in Progress

            var ga = new GlideAjax('checkIfGroupMember');
            ga.addParam('sysparm_name', 'isGroupMember');
            ga.addParam('sysparm_userid', g_user.userID);
            ga.addParam('sysparm_groupid', item.group);

            ga.getXMLAnswer(function(answer) {
                if (answer === 'true') {
                    // Unlock ONLY the variable set (pencil icon appears)
                    g_form.setReadOnly(item.set, false);
                }
            });
        }
    });
}

