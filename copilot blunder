function onCondition() {

    // Check if user is actually a member of Unisys group
    var ga = new GlideAjax('checkIfGroupMember');
    ga.addParam('sysparm_name', 'isGroupMember');
    ga.addParam('sysparm_userid', g_user.userID);
    ga.addParam('sysparm_groupid', 'e63d5e85b1611110964668d72675c6f8');  // Unisys Windows Projects group

    ga.getXMLAnswer(function(answer) {

        if (answer === 'true') {

            // Make variable set editable so pencil icon appears
